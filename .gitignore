node_modules/
dist/
releases/
.next/
next-env.d.ts

# macOS Finder metadata — rewritten just by browsing a folder, so tracking it
# means a permanently dirty working tree and unmergeable binary conflicts
.DS_Store

# TypeScript incremental build cache — regenerated by every tsc run
*.tsbuildinfo

# Codex CLI local config — machine-specific, not part of the project
.codex/

# personal design/notes docs (see gitignore-notes-md-convention memory)
design-docs.md
dev-notes.md

# Chrome Web Store API credentials — client secret + refresh token, written by
# `npm run cws:auth`. Never commit; it can publish to the store on your behalf.
.cws-credentials.json
